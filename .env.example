KITE_API_KEY=
KITE_API_SECRET=
LIVE_TRADING_ENABLED=false
API_PORT=8787
# Bind address for the API server. Keep 127.0.0.1 locally; set 0.0.0.0 only
# behind a reverse proxy / firewall on a VPS.
API_HOST=127.0.0.1
# Origin allowed for CORS (the dev frontend). Same-origin serving needs none.
ALLOWED_ORIGIN=http://127.0.0.1:5175
# Optional comma-separated NSE holiday dates, YYYY-MM-DD.
NSE_HOLIDAYS=
# Telegram notifications (create a bot with @BotFather, message it once,
# then read your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
